{
  "name": "klantenkaart",
  "version": "1.0.0",
  "private": true,
  "description": "Klantenkaart - al je klanten op de kaart, gekleurd naar hoe lang geleden je er langsging.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "seed": "node --no-warnings server/seed.js",
    "test": "node --no-warnings --test \"test/*.test.js\"",
    "test:pg": "node --no-warnings --test \"test/*.test.js\""
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
